{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "orca *",
      "git commit*",
      "git merge*",
      "./scripts/orca/check.sh*",
      "./scripts/orca/plan-gates.sh*",
      "./scripts/orca/verify-main.sh*",
      "./scripts/orca/orca-watch.sh*",
      "./scripts/orca/install-main.sh*",
      "./scripts/orca/remove-worktree.sh*",
      "./scripts/orca/wait.sh*",
      "./scripts/orca/review.sh*",
      "./scripts/orca/sign-probe.sh*"
    ],
    "filesystem": {
      "allowWrite": [
        "/Users/serhii/Developer/emdash-images/.git",
        "/Users/serhii/Developer/emdash-images/.scratch/runs",
        "/Users/serhii/Developer/emdash-images/.worktrees"
      ]
    }
  },
  "permissions": {
    "additionalDirectories": [
      "/Users/serhii/Developer/emdash-images/.scratch/runs"
    ],
    "allow": [
      "Bash(orca *)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(./scripts/orca/check.sh*)",
      "Bash(./scripts/orca/plan-gates.sh*)",
      "Bash(./scripts/orca/verify-main.sh*)",
      "Bash(./scripts/orca/orca-watch.sh*)",
      "Bash(./scripts/orca/install-main.sh*)",
      "Bash(./scripts/orca/remove-worktree.sh*)",
      "Bash(./scripts/orca/wait.sh*)",
      "Bash(./scripts/orca/review.sh*)",
      "Bash(./scripts/orca/sign-probe.sh*)",
      "mcp__emdash-docs",
      "mcp__astro-docs",
      "mcp__context7"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove *)",
      "Bash(git -c *)",
      "Bash(git --config-env*)",
      "Bash(git config *)",
      "Bash(git * --no-verify*)",
      "Bash(git remote *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Bash(git * --no-gpg-sign*)",
      "Bash(git push*)",
      "Bash(git tag *)"
    ]
  },
  "enabledMcpjsonServers": [
    "emdash-docs",
    "astro-docs"
  ]
}
