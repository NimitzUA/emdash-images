{
	"name": "@nimitzua/emdash-images",
	"version": "0.3.1",
	"description": "Reusable server-side image pipeline for EmDash.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"astro",
		"image",
		"avif",
		"webp",
		"sharp"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NimitzUA/emdash-images.git"
	},
	"homepage": "https://github.com/NimitzUA/emdash-images#readme",
	"bugs": {
		"url": "https://github.com/NimitzUA/emdash-images/issues"
	},
	"engines": {
		"node": ">=26"
	},
	"main": "./src/index.mjs",
	"types": "./src/index.d.mts",
	"bin": {
		"emdash-images": "src/bin.mjs"
	},
	"exports": {
		".": {
			"types": "./src/index.d.mts",
			"import": "./src/index.mjs"
		},
		"./service": {
			"types": "./src/service.d.mts",
			"import": "./src/service.mjs"
		},
		"./layout": {
			"types": "./src/layout.d.mts",
			"import": "./src/layout.mjs"
		},
		"./plugin": {
			"types": "./src/plugin.d.mts",
			"import": "./src/plugin.mjs"
		},
		"./Picture.astro": "./src/Picture.astro",
		"./PortableTextImage.astro": "./src/PortableTextImage.astro",
		"./warmup": {
			"types": "./src/warmup.d.mts",
			"import": "./src/warmup.mjs"
		},
		"./maintenance": {
			"types": "./src/maintenance.d.mts",
			"import": "./src/maintenance.mjs"
		}
	},
	"files": [
		"src",
		"README.md",
		"SKILL.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"astro": "^7.3.2",
		"emdash": "^1.3.0",
		"sharp": "^0.35.5"
	},
	"dependencies": {
		"@unpic/placeholder": "^0.1.2",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"astro": "^7.3.2",
		"emdash": "^1.3.0",
		"sharp": "^0.35.5",
		"vitest": "^5.0.5"
	},
	"scripts": {
		"test": "node --test && vitest run --reporter=verbose",
		"prepublishOnly": "npm test && node scripts/release.mjs verify"
	}
}
