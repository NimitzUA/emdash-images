# Generated by orca-setup from .orca-setup.json; change that file or the kit, not this one.
# Command rules for Codex workers in an Orca plan, loaded from the trusted project .codex layer
# (Orca runs Codex with its own CODEX_HOME, so ~/.codex/rules do not apply). An `allow` rule runs
# the command outside the sandbox, so it is kept only where the sandbox gets in the way; the
# strictest matching rule wins: `forbidden` > `prompt` > `allow`. Commit flags that skip hooks or
# signing are caught by scripts/orca/check-commits.sh at the merge gate.

# Codex keeps .git read-only in its sandbox, so these git subcommands run outside it. Every other
# git command stays sandboxed and cannot write .git.
prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "rev-parse", "restore", "add", "commit"]],
    decision = "allow",
    justification = "Read the repository, restore files and commit the task; other git commands stay sandboxed.",
    match = ["git status", "git diff"],
    not_match = ["git push", "git -C . push", "git config core.hooksPath x"],
)
prefix_rule(
    pattern = ["./scripts/orca/check.sh"],
    decision = "allow",
    justification = "The task checks in one run; they start the stack and browsers, which cannot run in the sandbox.",
)

prefix_rule(pattern = ["ps"], decision = "allow", justification = "Inspect processes.")
prefix_rule(pattern = ["lsof"], decision = "allow", justification = "Check ports.")

# Never run, not even after a prompt.

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Pushing is the user's call. Report that the work is committed instead.",
    match = ["git push", "git push origin main"],
    not_match = ["git pull"],
)
prefix_rule(
    pattern = ["git", "-c"],
    decision = "forbidden",
    justification = "No config overrides on git commands; hooks and signing stay on. Run the plain command.",
)
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Discards work irreversibly. Ask the architect.",
)
prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "forbidden",
    justification = "Deletes unmerged work.",
)
prefix_rule(
    pattern = ["git", "worktree"],
    decision = "forbidden",
    justification = "Orca owns worktrees. Ask the architect.",
)
prefix_rule(
    pattern = ["gh"],
    decision = "forbidden",
    justification = "No remote operations from executors.",
)

prefix_rule(
    pattern = ["git", "commit", "--no-gpg-sign"],
    decision = "forbidden",
    justification = "Commits stay signed. If signing fails twice, leave the changes staged and finish with worker_done --outcome failed (AGENTS.md).",
)

prefix_rule(
    pattern = ["orca", ["terminal", "keypress", "repo", "project", "automations"]],
    decision = "forbidden",
    justification = "Controls other terminals, keys or Orca configuration. Ask the architect.",
)
prefix_rule(
    pattern = ["orca", "worktree", ["rm", "create"]],
    decision = "forbidden",
    justification = "The architect owns worktrees. Ask the architect.",
)
prefix_rule(
    pattern = [["./scripts/orca/plan-gates.sh", "./scripts/orca/verify-main.sh", "./scripts/orca/remove-worktree.sh", "./scripts/orca/install-main.sh", "./scripts/orca/review.sh", "./scripts/orca/wait.sh"]],
    decision = "forbidden",
    justification = "Plan gates, reviews, waits and the fresh-worktree gate belong to the architect. Use ./scripts/orca/check.sh.",
)
prefix_rule(
    pattern = ["orca", "skills"],
    decision = "forbidden",
    justification = "AGENTS.md (Working in Orca) and the preamble hold every Orca command a task needs. Executors loaded Orca skills 283 times in 205 of 403 sessions although the rules said not to.",
    match = ["orca skills get orca-cli", "orca skills list"],
    not_match = ["orca orchestration check"],
)

prefix_rule(
    pattern = ["git", "tag"],
    decision = "forbidden",
    justification = "Release tags are the user's; the release process is not decided yet.",
)

# Ask first.

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf"]],
    decision = "prompt",
    justification = "Recursive delete. Prefer deleting named files.",
    match = ["rm -rf bin"],
    not_match = ["rm file.txt"],
)
